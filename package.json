{
  "name": "cognition",
  "version": "0.0.1",
  "private": true,
  "description": "Personal autonomous generative sound engine for deep work and cognitive states",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run dsp && electron-vite build",
    "start": "electron .",
    "dsp": "node tools/dsp/build-dsp.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "selftest": "npm run build && electron . --selftest",
    "render": "node tools/render/cli.ts",
    "family-report": "node tools/render/family-report.ts"
  },
  "devDependencies": {
    "@grame/faustwasm": "0.19.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.1",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
